# ---------------------------------------------------------------------------
# Boards — never pushed to this repository
# ---------------------------------------------------------------------------
# Real boards (copies, projects and results) live here for local tests; the test
# suite solves every boards_local/**/*.coppernicus.yml it finds.
boards_local/
# Any board or board-derived file anywhere else is ignored too, in case one is
# copied into the tree by mistake ...
*.kicad_pcb
*.kicad_pro
*.kicad_sch
*.kicad_pcb.bak
*.kicad_sch.bak
*.kicad_pro.bak*
*.kicad_pcb.*.bak
*.json.gz
*.hyp
*.tgz
*.gbr
*.drl
# ... except the synthetic examples, and small boards drawn on purpose for tests.
!examples/*/*.kipi.json.gz
!tests/boards/*.kicad_pcb
!tests/boards/*.kicad_pro

